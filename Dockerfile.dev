# syntax=docker/dockerfile:1

# The DEVELOPMENT image for Malloy model repos. Not to be confused with
# ./Dockerfile, which builds the Malloyyo server for self-hosting (docs/docker.md).
#
# This one carries the toolchain a model AUTHOR needs, so a project can be opened
# and worked on with nothing installed locally: the malloyyo CLI, Claude Code, gh,
# and the Google Cloud SDK for BigQuery-backed models. A devcontainer.json points
# at it and gets a working environment on first boot — see docs/devcontainer.md.
#
# It is big on purpose: the Google Cloud SDK alone is ~815 MB installed. That buys
# `gcloud auth application-default login` behaving the way it does on a laptop,
# which is the whole point — the alternative is telling a data analyst to install a
# C++ toolchain before their first query. Pull it once, use it for months.

ARG NODE_VARIANT=24-bookworm
FROM mcr.microsoft.com/devcontainers/typescript-node:${NODE_VARIANT}

LABEL org.opencontainers.image.source="https://github.com/malloydata/malloyyo"
LABEL org.opencontainers.image.description="Development environment for Malloy model repos: malloyyo CLI, Claude Code, gh, and the Google Cloud SDK."

# Pinned so the image and the CLI a project expects cannot drift silently. The
# publish workflow overrides this with the version it is releasing.
ARG MALLOYYO_VERSION=0.2.40
# Claude Code ships several times a week and updates itself in place, so pinning
# it buys staleness rather than reproducibility.
ARG CLAUDE_CODE_VERSION=latest

# `lz4`, reached through @malloydata/malloy, publishes no prebuilt binary — npm
# compiles it with node-gyp on install. Without a toolchain the malloyyo install
# below fails outright, and on Windows hosts that failure is exactly what this
# image exists to spare people. Explicit rather than inherited, so a base image
# change cannot quietly remove it.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential python3 apt-transport-https ca-certificates gnupg curl; \
    rm -rf /var/lib/apt/lists/*

# Google Cloud SDK — `gcloud` and `bq`. Application Default Credentials written by
# `gcloud auth application-default login` are what @malloydata/db-bigquery reads,
# so this is the "log in the usual way" path for a BigQuery model. The apt repo
# serves amd64 and arm64, so this layer builds on both.
RUN set -eux; \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
        > /etc/apt/sources.list.d/google-cloud-sdk.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends google-cloud-cli; \
    rm -rf /var/lib/apt/lists/*

# gh — cloning private model repos, and pushing the branch you just authored.
RUN set -eux; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*

# The two CLIs the author actually drives. Installed as root into the global
# prefix so every user in the container sees them.
RUN set -eux; \
    npm install -g \
        "@malloydata/malloyyo@${MALLOYYO_VERSION}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm cache clean --force

# `malloyyo login` completes its OAuth round trip by listening for a redirect on
# THIS machine. On a laptop any free loopback port works; in a container neither
# half holds — the port has to be known in advance to be published, and the
# forwarded connection arrives on the container's interface rather than its
# loopback. Pinning both here means `malloyyo login` works as long as 41121 is
# published (`-p 41121:41121`, or devcontainer `appPort`).
#
# The listener is up only for the duration of a sign-in, and the exchange is
# protected by PKCE + state, so binding it to the container's interfaces for
# those few minutes is the intended trade.
ENV MALLOYYO_OAUTH_PORT=41121 \
    MALLOYYO_OAUTH_HOST=0.0.0.0

# 4173 serves the dashboard shell; `malloyyo dashboard dev` renders custom
# (iframe) dashboards from a separate artifact origin on 4174, and they come up
# blank without it. 41121 is the sign-in redirect above.
EXPOSE 4173 4174 41121

USER node

# DuckDB fetches `httpfs` the first time a model reads Parquet or CSV over
# HTTPS, which is most of them — including every model that starts from the
# sample data. Installing it at build time means a fresh container's first query
# is a query rather than a download, and running it as `node` puts it in the
# ~/.duckdb the runtime user actually reads. Per-architecture, resolved by the
# build platform.
RUN cd /tmp && malloyyo sql -e "INSTALL httpfs"
